# Copiar como .env y exportar antes de arrancar el backend.
DB_URL=jdbc:postgresql://localhost:5432/vitialert
DB_USERNAME=vitialert
DB_PASSWORD=cambiar
SERVER_PORT=8080
API_KEY=cambiar-por-una-clave-larga
NODE_DEFAULT_LATITUDE=-31.6550
NODE_DEFAULT_LONGITUDE=-68.5750

# Horas que un riego puede quedar abierto antes de que el watchdog lo de de baja.
IRRIGATION_MAX_OPEN_HOURS=6

# VitiAI satelital (opcional)
SATELLITE_ENABLED=false
SATELLITE_BASE_URL=http://localhost:8000
# En local VitiAI responde al instante; en Render free hay que esperarle el arranque en frio.
SATELLITE_TIMEOUT_MS=5000

# Modelo Python (opcional)
ML_ENABLED=false
ML_BASE_URL=http://localhost:8002
