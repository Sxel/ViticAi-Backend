# Copiar como .env y exportar antes de arrancar el backend.
DB_URL=jdbc:postgresql://localhost:5432/vitialert
DB_USERNAME=vitialert
DB_PASSWORD=cambiar
SERVER_PORT=8080

# Integraciones externas (opcionales)
SATELLITE_ENABLED=false
SATELLITE_BASE_URL=http://localhost:8000
WEATHER_PULL_ENABLED=false
WEATHER_BASE_URL=http://localhost:8001
ML_ENABLED=false
ML_BASE_URL=http://localhost:8002

# Seguridad opcional
NODE_KEY_ENABLED=false
ADMIN_KEY_ENABLED=false
ADMIN_KEY=
